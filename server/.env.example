# Copy this file to .env in the /server folder and fill with real values
# SECRET for signing JWTs
JWT_SECRET=change_this_to_a_long_random_string

# SQLite database path
DATABASE_PATH=./data/db.sqlite3

# Instagram Basic Display API access token & user id
# See: https://developers.facebook.com/docs/instagram-basic-display-api
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Stripe keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Simple admin token for viewing orders/users via /api/admin/* (set a long random string)
ADMIN_TOKEN=change_this_to_a_secure_token

# Optional: PORT the server listens on
PORT=3000
