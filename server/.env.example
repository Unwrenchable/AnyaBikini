# Copy this file to `.env` in the project root and fill with real values.
# These variables are also the names you should configure in Vercel's dashboard
# when deploying the project.

# JWT secret for signing authentication tokens
JWT_SECRET=change_this_to_a_long_random_string

# Path to JSON database used by server/service modules (relative to repo root)
# In production/CI this should point to a writable location; Vercel's filesystem
# is ephemeral, so you'd normally use an external database instead.
DATABASE_PATH=./server/data/db.json

# Instagram Basic Display API access token & user id
# See: https://developers.facebook.com/docs/instagram-basic-display-api
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Stripe keys (required for payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Admin token used by certain API routes (/api/admin/*)
ADMIN_TOKEN=change_this_to_a_secure_token

# Optional: PORT the local Express server listens on (ignored by Vercel)
PORT=3000
